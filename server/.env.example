# ========================================
# 喵喵电竞 - 后端配置文件
# 复制此文件为 .env 并填写实际值
# ========================================

# -------- 基础配置 --------
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# -------- 数据库配置 --------
# 开发环境使用SQLite，生产环境切换为MySQL
# SQLite (开发):
DATABASE_URL="file:./dev.db"
# MySQL (生产):
# DATABASE_URL="mysql://user:password@localhost:3306/miaomiao"
# PostgreSQL (可选):
# DATABASE_URL="postgresql://user:password@localhost:5432/miaomiao"

# -------- Redis配置 (可选，生产环境建议开启) --------
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"

# -------- JWT配置 --------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# -------- 短信服务 (阿里云SMS) --------
SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
SMS_SIGN_NAME=喵喵电竞
SMS_TEMPLATE_CODE=SMS_123456789

# -------- 微信支付 --------
WECHAT_APP_ID=your-wechat-app-id
WECHAT_MCH_ID=your-merchant-id
WECHAT_API_KEY_V3=your-api-key-v3
WECHAT_SERIAL_NO=your-certificate-serial-no
WECHAT_PRIVATE_KEY_PATH=./certs/wechat/apiclient_key.pem
WECHAT_NOTIFY_URL=https://api.yourdomain.com/api/v1/payment/wechat/notify

# -------- 支付宝 --------
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-private-key
ALIPAY_ALIPAY_PUBLIC_KEY=alipay-public-key
ALIPAY_NOTIFY_URL=https://api.yourdomain.com/api/v1/payment/alipay/notify

# -------- 对象存储 (阿里云OSS) --------
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET=miaomiao-assets
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# -------- 实时通信 (声网Agora) --------
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# -------- 推送服务 (极光推送) --------
JPUSH_APP_KEY=your-jpush-app-key
JPUSH_MASTER_SECRET=your-jpush-master-secret

# -------- 日志配置 --------
LOG_LEVEL=debug
LOG_DIR=./logs
